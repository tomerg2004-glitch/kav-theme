<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="rtl">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }}</title>
  <link href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@300;500&family=Heebo:wght@400;500;800&display=swap" rel="stylesheet">
  <style>:root{--paper:{{ settings.color_paper }};--ink:{{ settings.color_ink }};--accent:{{ settings.color_accent }};--muted:{{ settings.color_muted }};--line:{{ settings.color_line }};--card:{{ settings.color_card }};}</style>
  {{ 'kav.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <main id="MainContent">{{ content_for_layout }}</main>
</body>
</html>
