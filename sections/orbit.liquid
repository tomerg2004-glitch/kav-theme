{%- comment -%}
  ORBIT hero — space runway.
  Warp-speed starfield (canvas) + endless perspective runway floor under the cast,
  so the two looks march toward the camera forever. They materialize like holograms
  (scan bar + RGB split), the headline decodes from glyph noise, a HUD frames it all.
  Scroll (pinned): hyperspace streaks, the cast walks past the camera and splits.
  Motion: GSAP + ScrollTrigger from CDN, with a vanilla fallback; reduced-motion = still frame.
{%- endcomment -%}
{%- liquid
  assign img1 = section.settings.image
  assign img2 = section.settings.image2
-%}
<section class="ko" id="Orbit-{{ section.id }}" aria-labelledby="OrbitH-{{ section.id }}">
  <div class="ko__stage">
    <canvas class="ko__stars" aria-hidden="true"></canvas>
    <div class="ko__nebula" aria-hidden="true"></div>
    <div class="ko__planet" aria-hidden="true"><span></span></div>
    <div class="ko__floor" aria-hidden="true"><div class="ko__grid"></div></div>

    <p class="ko__mark" aria-hidden="true">{%- assign wm = section.settings.wordmark | default: 'KAV' | split: '' -%}{%- for ch in wm -%}<span>{{ ch }}</span>{%- endfor -%}</p>

    <div class="ko__cast">
      {%- for n in (1..2) -%}
        {%- if n == 1 -%}{%- assign img = img1 -%}{%- assign lbl = section.settings.label1 -%}{%- assign lnk = section.settings.link1 -%}{%- assign code = 'LOOK.01' -%}{%- else -%}{%- assign img = img2 -%}{%- assign lbl = section.settings.label2 -%}{%- assign lnk = section.settings.link2 -%}{%- assign code = 'LOOK.02' -%}{%- endif -%}
        {%- if img -%}
          {%- assign alt = img.alt | default: lbl -%}
          {%- assign src = img | image_url: width: 1200 -%}
          <a class="ko__fig ko__fig--{{ n }}" href="{{ lnk | default: '#' }}">
            <span class="ko__walk">
              <span class="ko__holo">
                {{ img | image_url: width: 1200 | image_tag: widths: '500,800,1200', sizes: '(min-width: 750px) 36vw, 62vw', fetchpriority: 'high', class: 'ko__img', alt: alt }}
                <img class="ko__ghost ko__ghost--r" src="{{ src }}" alt="" aria-hidden="true">
                <img class="ko__ghost ko__ghost--c" src="{{ src }}" alt="" aria-hidden="true">
                <span class="ko__scan" aria-hidden="true"></span>
              </span>
            </span>
            <span class="ko__node" aria-hidden="true"><i></i></span>
            <span class="ko__tag"><b data-decode>{{ code }}</b><span data-decode>{{ lbl }}</span></span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="ko__vignette" aria-hidden="true"></div>

    <div class="ko__hud" aria-hidden="true">
      <span class="ko__corner ko__corner--tl"></span><span class="ko__corner ko__corner--tr"></span>
      <span class="ko__corner ko__corner--bl"></span><span class="ko__corner ko__corner--br"></span>
      <p class="ko__meta ko__meta--tl"><span class="ko__dot"></span>KAV/SYS <em>ONLINE</em></p>
      <p class="ko__meta ko__meta--tr">32.0853°N · 34.7818°E</p>
      <p class="ko__meta ko__meta--ml">SEASON <em>26/27</em><br>DROP <em>001</em></p>
      <p class="ko__meta ko__meta--mr">TLV <em data-clock>--:--:--</em><br>VEL <em data-vel>0.00</em> c</p>
      <span class="ko__beam"></span>
    </div>

    <div class="ko__copy k-wrap">
      <h1 id="OrbitH-{{ section.id }}" class="ko__h1"><span class="ko__h1-line" data-decode data-delay="1700">{{ section.settings.headline }}</span></h1>
      <div class="ko__side">
        {%- if section.settings.season != blank -%}<p class="ko__season"><span data-decode data-delay="2100">{{ section.settings.season }}</span></p>{%- endif -%}
        {%- if section.settings.btn_label != blank -%}
          <a class="ko__btn" href="{{ section.settings.btn_link | default: '#cat-shoes' }}" data-magnet>
            <span class="ko__btn-txt">{{ section.settings.btn_label }}</span>
            <span class="ko__btn-ic"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v12M3 9l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></span>
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="ko__cue" aria-hidden="true"><span>SCROLL</span><i></i></div>
  </div>
</section>

<style>
.ko{--p:0;--mx:0;--my:0;--acc:#c8ff3d;position:relative;height:220vh;background:#020203;color:#eef0f2;margin-top:calc(-1 * var(--hdr-h,76px));font-family:Heebo,system-ui,sans-serif}
.ko__stage{position:sticky;top:0;height:100svh;min-height:520px;overflow:hidden;isolation:isolate;perspective:900px}
.ko__stars{position:absolute;inset:0;width:100%;height:100%;z-index:0;display:block}
.ko__nebula{position:absolute;inset:-20%;z-index:0;pointer-events:none;background:
  radial-gradient(40% 30% at 22% 30%,rgba(90,110,255,.10),transparent 70%),
  radial-gradient(35% 28% at 80% 22%,rgba(200,255,61,.06),transparent 70%),
  radial-gradient(60% 40% at 50% 100%,rgba(120,140,255,.10),transparent 70%);
  transform:translate(calc(var(--mx)*-18px),calc(var(--my)*-12px));animation:koDrift 18s ease-in-out infinite alternate}
@keyframes koDrift{to{transform:translate(calc(var(--mx)*-18px + 2%),calc(var(--my)*-12px - 1.5%)) rotate(2deg)}}

/* eclipse planet on the horizon */
.ko__planet{position:absolute;z-index:1;left:50%;top:58%;width:min(120vw,1500px);aspect-ratio:1;transform:translate(-50%,0) translateY(calc(var(--p)*-10%));border-radius:50%;pointer-events:none;
  background:radial-gradient(circle at 50% 50%,#05060a 60%,transparent 60.4%);opacity:0;animation:koIn 2.4s ease-out .4s forwards}
.ko__planet::before{content:"";position:absolute;inset:-1px;border-radius:50%;box-shadow:0 -2px 0 0 rgba(220,230,255,.55),0 -18px 60px -10px rgba(140,160,255,.45),0 -40px 160px -30px rgba(200,255,61,.18)}
.ko__planet span{position:absolute;inset:0;border-radius:50%;background:conic-gradient(from 180deg,transparent 0 40%,rgba(200,255,61,.5) 48%,transparent 56%);-webkit-mask:radial-gradient(circle,transparent 59.6%,#000 60%,#000 60.6%,transparent 61%);mask:radial-gradient(circle,transparent 59.6%,#000 60%,#000 60.6%,transparent 61%);animation:koOrbit 9s linear infinite}
@keyframes koOrbit{to{transform:rotate(360deg)}}

/* endless runway floor */
.ko__floor{position:absolute;z-index:2;left:-60%;right:-60%;bottom:0;height:90%;transform-origin:50% 100%;transform:rotateX(72deg);pointer-events:none;
  -webkit-mask-image:linear-gradient(to top,#000 10%,transparent 92%);mask-image:linear-gradient(to top,#000 10%,transparent 92%);opacity:0;animation:koIn 1.6s ease-out .2s forwards}
.ko__grid{position:absolute;inset:-100% 0 0;background-image:
  linear-gradient(rgba(200,255,61,.55) 1.5px,transparent 1.5px),
  linear-gradient(90deg,rgba(170,190,255,.32) 1px,transparent 1px);
  background-size:90px 90px;animation:koRun 1.1s linear infinite;will-change:transform}
.ko__floor::after{content:"";position:absolute;left:44%;right:44%;top:0;bottom:0;background:linear-gradient(90deg,transparent,rgba(200,255,61,.14),transparent)}
@keyframes koRun{from{transform:translateY(0)}to{transform:translateY(90px)}}
@keyframes koIn{to{opacity:1}}

/* giant wordmark */
.ko__mark{position:absolute;z-index:1;inset-inline:0;top:44%;margin:0;display:flex;justify-content:center;direction:ltr;font-family:Unbounded,Heebo,sans-serif;font-weight:900;font-size:clamp(150px,30vw,520px);line-height:.8;letter-spacing:-.02em;color:transparent;-webkit-text-stroke:1px rgba(220,230,255,.14);pointer-events:none;user-select:none;
  transform:translate(calc(var(--mx)*-30px),calc(-50% + var(--p)*-18vh)) scale(calc(1 + var(--p)*.5))}
.ko__mark span{display:inline-block;opacity:0;filter:blur(18px);transform:translateZ(-400px) translateY(30%)}

/* cast */
.ko__cast{position:absolute;inset:0;z-index:3;mix-blend-mode:lighten}
.ko__fig{position:absolute;bottom:4vh;height:84%;aspect-ratio:4/5;display:block;color:inherit;text-decoration:none;transform-origin:50% 100%;
  transform:translateX(calc(var(--mx)*14px*var(--d,1) + var(--side)*var(--p)*34vw)) scale(calc(1 + var(--p)*.7));opacity:calc(1 - var(--p)*1.2)}
.ko__fig--1{inset-inline-start:50%;margin-inline-start:-6%;--side:1;--d:1.3}
.ko__fig--2{inset-inline-end:50%;margin-inline-end:-6%;--side:-1;--d:.8}
[dir="rtl"] .ko__fig--1{--side:-1}
[dir="rtl"] .ko__fig--2{--side:1}
.ko__walk,.ko__holo{position:absolute;inset:0;display:block;transform-origin:50% 100%}
.ko__img,.ko__ghost{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;object-position:50% 100%;
  -webkit-mask-image:radial-gradient(46% 60% at 50% 46%,#000 50%,transparent 100%);mask-image:radial-gradient(46% 60% at 50% 46%,#000 50%,transparent 100%)}
.ko__img{filter:contrast(1.08) saturate(.9)}
.ko__ghost{opacity:0;mix-blend-mode:screen;pointer-events:none}
.ko__ghost--r{filter:sepia(1) saturate(6) hue-rotate(-50deg) brightness(.8)}
.ko__ghost--c{filter:sepia(1) saturate(6) hue-rotate(140deg) brightness(.8)}
.ko__scan{position:absolute;left:8%;right:8%;top:0;height:2px;background:var(--acc);box-shadow:0 0 18px 4px rgba(200,255,61,.6);opacity:0}
.ko__holo{clip-path:inset(0 0 100% 0)}
.ko__node{position:absolute;top:34%;inset-inline-start:62%;width:12px;height:12px;border-radius:50%;border:1px solid var(--acc);opacity:0}
.ko__node i{position:absolute;inset:3px;border-radius:50%;background:var(--acc);animation:koPing 2.2s ease-out infinite}
@keyframes koPing{0%{box-shadow:0 0 0 0 rgba(200,255,61,.6)}80%,100%{box-shadow:0 0 0 14px rgba(200,255,61,0)}}
.ko__fig--2 .ko__node{inset-inline-start:auto;inset-inline-end:62%}
.ko__tag{position:absolute;top:calc(34% - 54px);inset-inline-start:66%;display:flex;flex-direction:column;gap:2px;padding:8px 12px;border-inline-start:1px solid var(--acc);background:linear-gradient(90deg,rgba(200,255,61,.10),transparent);font-family:"JetBrains Mono",monospace;font-size:11px;letter-spacing:.08em;white-space:nowrap;opacity:0;transform:translateX(-8px);transition:opacity .3s ease,transform .45s cubic-bezier(.16,1,.3,1)}
[dir="rtl"] .ko__tag{transform:translateX(8px)}
.ko__tag b{color:var(--acc);font-weight:600}
.ko__fig--2 .ko__tag{inset-inline-start:auto;inset-inline-end:66%;border-inline-start:0;border-inline-end:1px solid var(--acc);background:linear-gradient(-90deg,rgba(200,255,61,.10),transparent);align-items:flex-end}
.ko__fig:hover .ko__tag,.ko__fig:focus-visible .ko__tag,.ko.is-live .ko__tag{opacity:1;transform:none}
@media (hover:hover){.ko__cast:hover .ko__fig:not(:hover) .ko__img{filter:brightness(.35) saturate(.4)}}
.ko__fig:focus-visible{outline:1px solid var(--acc);outline-offset:-8px}

.ko__vignette{position:absolute;inset:0;z-index:4;pointer-events:none;background:radial-gradient(120% 90% at 50% 45%,transparent 55%,rgba(2,2,3,.85) 100%),linear-gradient(to top,rgba(2,2,3,.8),transparent 26%)}

/* HUD */
.ko__hud{position:absolute;inset:clamp(14px,2.4vw,32px);top:calc(var(--hdr-h,76px) + 10px);z-index:5;pointer-events:none;font-family:"JetBrains Mono",monospace;font-size:11px;letter-spacing:.14em;color:rgba(238,240,242,.62);opacity:0;animation:koIn 1s ease-out 1.2s forwards}
.ko__corner{position:absolute;width:22px;height:22px;border:1px solid rgba(238,240,242,.35)}
.ko__corner--tl{top:0;left:0;border-right:0;border-bottom:0}.ko__corner--tr{top:0;right:0;border-left:0;border-bottom:0}
.ko__corner--bl{bottom:0;left:0;border-right:0;border-top:0}.ko__corner--br{bottom:0;right:0;border-left:0;border-top:0}
.ko__meta{position:absolute;margin:0;direction:ltr;line-height:1.7}
.ko__meta em{font-style:normal;color:#eef0f2}
.ko__meta--tl{top:6px;left:34px}.ko__meta--tr{top:6px;right:34px}
.ko__meta--ml{left:0;top:42%}.ko__meta--mr{right:0;top:42%;text-align:right}
.ko__dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--acc);margin-right:8px;vertical-align:1px;animation:koBlink 1.6s steps(2) infinite}
@keyframes koBlink{50%{opacity:.2}}
.ko__beam{position:absolute;left:0;right:0;top:0;height:1px;background:linear-gradient(90deg,transparent,rgba(200,255,61,.5),transparent);animation:koSweep 5.5s cubic-bezier(.65,0,.35,1) 2s infinite}
@keyframes koSweep{0%{transform:translateY(0);opacity:0}10%{opacity:1}90%{opacity:1}100%{transform:translateY(calc(100svh - 160px));opacity:0}}

/* copy */
.ko__copy{position:absolute;inset-inline:0;bottom:0;z-index:6;padding-bottom:calc(clamp(26px,5vh,58px) + 40px);display:flex;align-items:flex-end;justify-content:space-between;gap:20px 40px;pointer-events:none;transform:translateY(calc(var(--p)*-10vh));opacity:calc(1 - var(--p)*1.8)}
.ko__copy a{pointer-events:auto}
.ko__h1{margin:0;font-family:Heebo,sans-serif;font-weight:200;font-size:clamp(40px,min(6vw,10vh),112px);line-height:.95;letter-spacing:-.035em;max-width:none;white-space:nowrap;text-shadow:0 0 40px rgba(140,160,255,.25)}
.ko__h1-line{display:inline}
.ko__h1 .g{color:var(--acc);font-family:"JetBrains Mono",monospace;font-weight:400}
.ko__side{display:flex;flex-direction:column;align-items:flex-start;gap:16px;flex:none}
.ko__season{margin:0;font-family:"JetBrains Mono",monospace;font-size:12px;letter-spacing:.2em;color:rgba(238,240,242,.7)}
.ko__btn{position:relative;display:inline-flex;align-items:center;gap:14px;min-height:56px;padding:0 10px 0 26px;border-radius:999px;background:rgba(238,240,242,.06);border:1px solid rgba(238,240,242,.28);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);color:#eef0f2;font-size:15px;font-weight:500;text-decoration:none;overflow:hidden;transition:transform .5s cubic-bezier(.16,1,.3,1),border-color .3s ease;opacity:0}
[dir="rtl"] .ko__btn{padding:0 26px 0 10px}
.ko__btn::before{content:"";position:absolute;inset:0;background:var(--acc);transform:scaleX(0);transform-origin:right;transition:transform .55s cubic-bezier(.16,1,.3,1);z-index:-1}
.ko__btn-ic{display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:var(--acc);color:#020203;transition:background .3s ease}
.ko__btn-ic svg{width:15px;height:15px;transition:transform .45s cubic-bezier(.16,1,.3,1)}
@media (hover:hover){.ko__btn:hover{color:#020203;border-color:var(--acc)}.ko__btn:hover::before{transform:scaleX(1)}.ko__btn:hover .ko__btn-ic{background:#020203;color:var(--acc)}.ko__btn:hover .ko__btn-ic svg{transform:translateY(3px)}}
.ko__btn:focus-visible{outline:2px solid var(--acc);outline-offset:4px}
.ko__btn:active{transform:scale(.97)}

.ko__cue{position:absolute;z-index:6;left:50%;bottom:30px;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:8px;font-family:"JetBrains Mono",monospace;font-size:10px;letter-spacing:.3em;color:rgba(238,240,242,.5);opacity:calc(1 - var(--p)*5)}
.ko__cue i{width:1px;height:34px;background:linear-gradient(var(--acc),transparent);animation:koCue 1.8s ease-in-out infinite}
@keyframes koCue{0%{transform:scaleY(0);transform-origin:top}50%{transform:scaleY(1);transform-origin:top}51%{transform-origin:bottom}100%{transform:scaleY(0);transform-origin:bottom}}

.template-index .k-header:not(.is-scrolled):not(.is-open){background:transparent;color:#fff}

@media (max-width:749px){
  .ko{height:170vh}
  .ko__fig{height:58%;bottom:30%}
  .ko__fig--1{margin-inline-start:-18%}.ko__fig--2{margin-inline-end:-18%}
  .ko__meta--ml,.ko__meta--mr,.ko__tag,.ko__node{display:none}
  .ko__copy{flex-direction:column;align-items:stretch}
  .ko__side{width:100%}
  .ko__btn{justify-content:space-between;width:100%}
  .ko__floor{height:48%}
}
@media (prefers-reduced-motion:reduce){
  .ko{height:auto}.ko__stage{position:relative}
  .ko *,.ko *::before,.ko *::after{animation:none!important;transition:none!important}
  .ko__holo{clip-path:none!important}.ko__mark span,.ko__btn,.ko__hud,.ko__floor,.ko__planet,.ko__node{opacity:1!important;filter:none!important;transform:none!important}
  .ko__fig{transform:none!important;opacity:1!important}
}
</style>

<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js" defer></script>
<script>
(() => {
  const boot = () => {
  const root = document.getElementById('Orbit-{{ section.id }}');
  if (!root || root.dataset.ready) return; root.dataset.ready = 1;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = matchMedia('(hover:hover) and (pointer:fine)').matches;
  const G = window.gsap;

  /* ---------- glyph decode ---------- */
  const glyphs = 'אבגדהוזחטיכלמנסעפצקרשת01<>/\\[]{}#$%&*+=-_:;KAV░▒▓';
  const decode = (el, delay = 0, dur = 900) => {
    const final = el.textContent; if (!final.trim()) return;
    if (reduce) return;
    el.setAttribute('aria-label', final);
    const chars = [...final];
    el.textContent = chars.map(c => c === ' ' ? ' ' : glyphs[Math.random() * glyphs.length | 0]).join('');
    setTimeout(() => {
      const t0 = performance.now();
      const tick = now => {
        const k = Math.min(1, (now - t0) / dur);
        const reveal = Math.floor(k * chars.length);
        el.textContent = chars.map((c, i) => i < reveal || c === ' ' ? c : glyphs[Math.random() * glyphs.length | 0]).join('');
        if (k < 1) requestAnimationFrame(tick); else { el.textContent = final; el.removeAttribute('aria-label'); }
      };
      requestAnimationFrame(tick);
    }, delay);
  };
  root.querySelectorAll('[data-decode][data-delay]').forEach(el => decode(el, +el.dataset.delay, 1100));

  /* ---------- starfield (warp) ---------- */
  const cv = root.querySelector('.ko__stars'); const ctx = cv.getContext('2d');
  let W, H, DPR = Math.min(2, devicePixelRatio || 1), stars = [];
  const N = innerWidth < 750 ? 260 : 620;
  const resize = () => { W = cv.clientWidth; H = cv.clientHeight; cv.width = W * DPR; cv.height = H * DPR; ctx.setTransform(DPR, 0, 0, DPR, 0, 0); };
  const spawn = s => { s.x = (Math.random() - .5) * 2; s.y = (Math.random() - .5) * 2; s.z = Math.random() * .9 + .1; s.pz = s.z; s.t = Math.random() < .12; return s; };
  resize(); for (let i = 0; i < N; i++) stars.push(spawn({}));
  addEventListener('resize', resize);
  let speed = reduce ? 0 : 0.045, base = 0.0016, mx = 0, my = 0, P = 0, running = true;
  const velEl = root.querySelector('[data-vel]');
  const draw = () => {
    if (!running) { requestAnimationFrame(draw); return; }
    const sp = speed + base + P * 0.03;
    ctx.fillStyle = 'rgba(2,2,3,' + (sp > .01 ? .35 : .9) + ')'; ctx.fillRect(0, 0, W, H);
    const cx = W / 2 + mx * 40, cy = H * .46 + my * 24;
    for (const s of stars) {
      s.pz = s.z; s.z -= sp;
      if (s.z <= .02) { spawn(s); s.z = 1; s.pz = 1; continue; }
      const k = 0.55 * Math.max(W, H);
      const x = cx + s.x / s.z * k, y = cy + s.y / s.z * k;
      const px = cx + s.x / s.pz * k, py = cy + s.y / s.pz * k;
      if (x < -50 || x > W + 50 || y < -50 || y > H + 50) { spawn(s); s.z = 1; s.pz = 1; continue; }
      const a = Math.min(1, (1 - s.z) * 1.3);
      ctx.strokeStyle = s.t ? `rgba(200,255,61,${a})` : `rgba(${200 + 55 * (1 - s.z) | 0},${215 + 40 * (1 - s.z) | 0},255,${a})`;
      ctx.lineWidth = (1 - s.z) * 2.2 + .2;
      ctx.beginPath(); ctx.moveTo(px, py); ctx.lineTo(x, y); ctx.stroke();
    }
    if (velEl) velEl.textContent = (sp * 20).toFixed(2);
    requestAnimationFrame(draw);
  };
  requestAnimationFrame(draw);
  new IntersectionObserver(([e]) => running = e.isIntersecting).observe(root);

  /* ---------- clock ---------- */
  const clk = root.querySelector('[data-clock]');
  const fmt = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Jerusalem', hour: '2-digit', minute: '2-digit', second: '2-digit' });
  if (clk) { const t = () => clk.textContent = fmt.format(new Date()); t(); setInterval(t, 1000); }

  if (reduce) return;

  /* ---------- entrance ---------- */
  const figs = [...root.querySelectorAll('.ko__fig')];
  const letters = root.querySelectorAll('.ko__mark span');
  const btn = root.querySelector('.ko__btn');
  const stepLoop = (walk, i) => {
    // march: a short dip every stride + weight shift; the moving floor sells the forward walk
    const dur = 1.08;
    if (G) {
      G.to(walk, { yPercent: 1.4, duration: dur / 4, ease: 'sine.inOut', yoyo: true, repeat: -1, delay: i * .27 });
      G.to(walk, { rotation: i ? -.7 : .7, duration: dur / 2, ease: 'sine.inOut', yoyo: true, repeat: -1, delay: i * .27 });
      G.to(walk, { xPercent: i ? -.8 : .8, duration: dur / 2, ease: 'sine.inOut', yoyo: true, repeat: -1, delay: i * .27 });
    } else {
      walk.animate([{ transform: 'translateY(0) rotate(0)' }, { transform: `translateY(1.4%) rotate(${i ? -.5 : .5}deg)` }, { transform: 'translateY(0) rotate(0)' }, { transform: `translateY(1.4%) rotate(${i ? .5 : -.5}deg)` }, { transform: 'translateY(0) rotate(0)' }], { duration: dur * 1000, iterations: Infinity, easing: 'ease-in-out', delay: i * 270 });
    }
  };
  if (G) {
    const tl = G.timeline({ defaults: { ease: 'expo.out' } });
    tl.to({ v: 0 }, { v: 1, duration: 1.6, ease: 'power2.inOut', onUpdate() { speed = .045 * (1 - this.targets()[0].v) + .002; } }, 0)
      .to(letters, { opacity: 1, filter: 'blur(0px)', z: 0, y: 0, duration: 1.8, stagger: .12 }, .3);
    figs.forEach((f, i) => {
      const holo = f.querySelector('.ko__holo'), scan = f.querySelector('.ko__scan'), walk = f.querySelector('.ko__walk');
      const gr = f.querySelector('.ko__ghost--r'), gc = f.querySelector('.ko__ghost--c');
      const t0 = .7 + i * .35;
      tl.fromTo(walk, { scale: .42, yPercent: -18, filter: 'brightness(.2) blur(6px)' }, { scale: 1, yPercent: 0, filter: 'brightness(1) blur(0px)', duration: 3.2, ease: 'power3.out' }, t0)
        .to(holo, { clipPath: 'inset(0 0 0% 0)', duration: 1.2, ease: 'power2.inOut' }, t0)
        .fromTo(scan, { top: '0%', opacity: 1 }, { top: '100%', duration: 1.2, ease: 'power2.inOut' }, t0)
        .to(scan, { opacity: 0, duration: .3 }, t0 + 1.2)
        .fromTo([gr, gc], { opacity: .9, x: (k) => k ? 14 : -14 }, { opacity: 0, x: 0, duration: 1.1, ease: 'power3.out' }, t0 + .4)
        .to(f.querySelector('.ko__node'), { opacity: 1, duration: .4 }, 2.6 + i * .2)
        .add(() => stepLoop(holo, i), t0 + .2);
    });
    tl.to(btn, { opacity: 1, duration: .8 }, 2.3)
      .add(() => { root.classList.add('is-live'); root.querySelectorAll('.ko__tag [data-decode]').forEach((el, k) => decode(el, k * 120, 700)); }, 3)
      .add(() => root.classList.remove('is-live'), 6.5);

    // occasional hologram glitch
    const glitch = () => {
      const f = figs[Math.random() * figs.length | 0]; if (!f) return;
      const g = f.querySelectorAll('.ko__ghost');
      G.timeline().to(g, { opacity: .7, x: k => k ? 6 : -6, duration: .06 }).to(f.querySelector('.ko__img'), { x: 3, duration: .05 }, 0).to(g, { opacity: 0, x: 0, duration: .25 }).to(f.querySelector('.ko__img'), { x: 0, duration: .1 }, '<');
      setTimeout(glitch, 3500 + Math.random() * 4500);
    };
    setTimeout(glitch, 5200);

    if (window.ScrollTrigger) {
      G.registerPlugin(ScrollTrigger);
      ScrollTrigger.create({ trigger: root, start: 'top top', end: 'bottom bottom', scrub: .6,
        onUpdate: s => { P = s.progress; root.style.setProperty('--p', s.progress.toFixed(4)); } });
    }
  } else {
    // fallback without GSAP
    root.querySelectorAll('.ko__holo').forEach(h => h.style.clipPath = 'none');
    letters.forEach((l, i) => l.animate([{ opacity: 0, filter: 'blur(18px)', transform: 'translateY(30%)' }, { opacity: 1, filter: 'blur(0)', transform: 'none' }], { duration: 1600, delay: 300 + i * 120, fill: 'forwards', easing: 'cubic-bezier(.16,1,.3,1)' }));
    figs.forEach((f, i) => { f.querySelector('.ko__node').style.opacity = 1; stepLoop(f.querySelector('.ko__holo'), i); });
    btn && (btn.style.opacity = 1); speed = .002;
  }
  if (!window.ScrollTrigger) {
    const onScroll = () => { const r = root.getBoundingClientRect(); const span = root.offsetHeight - innerHeight; P = Math.min(1, Math.max(0, -r.top / (span || 1))); root.style.setProperty('--p', P.toFixed(4)); };
    addEventListener('scroll', onScroll, { passive: true }); onScroll();
  }

  /* ---------- pointer depth + magnet ---------- */
  if (fine) {
    let tx = 0, ty = 0, raf = 0;
    const loop = () => { mx += (tx - mx) * .06; my += (ty - my) * .06; root.style.setProperty('--mx', mx.toFixed(4)); root.style.setProperty('--my', my.toFixed(4)); raf = Math.abs(tx - mx) + Math.abs(ty - my) > .001 ? requestAnimationFrame(loop) : 0; };
    root.addEventListener('pointermove', e => { const b = root.getBoundingClientRect(); tx = (e.clientX - b.left) / b.width * 2 - 1; ty = (e.clientY - b.top) / Math.min(b.height, innerHeight) * 2 - 1; if (!raf) raf = requestAnimationFrame(loop); });
    root.querySelectorAll('[data-magnet]').forEach(b => {
      b.addEventListener('pointermove', e => { const r = b.getBoundingClientRect(); b.style.transform = `translate(${(e.clientX - r.left - r.width / 2) * .22}px,${(e.clientY - r.top - r.height / 2) * .32}px)`; });
      b.addEventListener('pointerleave', () => b.style.transform = '');
    });
    root.querySelectorAll('.ko__fig').forEach(f => f.addEventListener('pointerenter', () => f.querySelectorAll('.ko__tag [data-decode]').forEach(el => decode(el, 0, 450))));
  }
  };
  if (document.readyState === 'complete') boot(); else addEventListener('load', boot);
})();
</script>

