{%- comment -%}
  ATELIER hero — editorial, quiet, expensive.
  Two full-height panels (one per look) open from a hairline like a cinema shutter.
  The looks push in slowly toward the viewer (they "walk" in), a soft light sheen passes over them.
  Centre: serif KAV logotype, a hairline that draws, the headline.
  Hover: the panel you point at widens, the other dims. Scroll (pinned): the panels part like doors.
{%- endcomment -%}
<section class="ka" id="Atelier-{{ section.id }}" aria-labelledby="AtelierH-{{ section.id }}">
  <div class="ka__stage">
    <div class="ka__panels">
      {%- for n in (1..2) -%}
        {%- if n == 1 -%}{%- assign img = section.settings.image -%}{%- assign lbl = section.settings.label1 -%}{%- assign lnk = section.settings.link1 -%}{%- else -%}{%- assign img = section.settings.image2 -%}{%- assign lbl = section.settings.label2 -%}{%- assign lnk = section.settings.link2 -%}{%- endif -%}
        {%- if img -%}
          {%- assign alt = img.alt | default: lbl -%}
          <a class="ka__panel ka__panel--{{ n }}" href="{{ lnk | default: '#' }}" data-cursor="{{ section.settings.cursor | escape }}">
            <span class="ka__media">
              {{ img | image_url: width: 1600 | image_tag: widths: '600,900,1200,1600', sizes: '50vw', fetchpriority: 'high', class: 'ka__img', alt: alt }}
              <span class="ka__sheen" aria-hidden="true"></span>
            </span>
            <span class="ka__label">
              <span class="ka__num" aria-hidden="true">0{{ n }}</span>
              <span class="ka__name">{{ lbl }}</span>
            </span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="ka__veil" aria-hidden="true"></div>
    <h1 id="AtelierH-{{ section.id }}" class="ka__sr">{{ section.settings.headline }}</h1>
    <a class="ka__cue" href="{{ section.settings.btn_link | default: '#cat-shoes' }}" aria-label="{{ section.settings.btn_label | escape }}"><i></i></a>
    <span class="ka__cursor" aria-hidden="true"><span></span></span>
  </div>
</section>

<style>
.ka{--p:0;--bone:#ece6dc;--ink:#0b0a09;position:relative;height:150vh;background:var(--ink);color:var(--bone);margin-top:calc(-1 * var(--hdr-h,76px))}
.ka__stage{position:sticky;top:0;height:100svh;min-height:520px;overflow:hidden;isolation:isolate}

/* panels = doors */
.ka__panels{position:absolute;inset:0;z-index:1;display:flex;gap:2px}
.ka__panel{position:relative;flex:1 1 0;min-width:0;overflow:hidden;color:inherit;text-decoration:none;transition:flex-grow 1.1s cubic-bezier(.22,1,.36,1);cursor:none;background:#050505}
.ka__panel--1{transform:translateX(calc(var(--p) * var(--dir,1) * -105%))}
.ka__panel--2{transform:translateX(calc(var(--p) * var(--dir,1) * 105%))}
[dir="rtl"] .ka__panel--1,[dir="rtl"] .ka__panel--2{--dir:-1}
@media (hover:hover) and (pointer:fine){
  .ka__panels:hover .ka__panel:hover{flex-grow:1.45}
  .ka__panels:hover .ka__panel:not(:hover) .ka__img{filter:brightness(.38) saturate(.6)}
  .ka__panels:hover .ka__panel:not(:hover) .ka__label{opacity:.35}
}
.ka__media{position:absolute;inset:0;display:block;clip-path:inset(50% 0 50% 0)}
.ka__img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 0%;transform-origin:50% 25%;filter:contrast(1.05) saturate(.88);transition:filter .9s ease;will-change:transform}
.ka__media::after{content:"";position:absolute;inset:0;background:linear-gradient(to top,rgba(11,10,9,.92),rgba(11,10,9,.35) 26%,rgba(11,10,9,0) 44%),linear-gradient(to bottom,rgba(11,10,9,.55),rgba(11,10,9,0) 22%);pointer-events:none}
.ka__sheen{position:absolute;inset:-20% -60%;background:linear-gradient(105deg,transparent 42%,rgba(255,248,236,.10) 50%,transparent 58%);transform:translateX(-60%);pointer-events:none;mix-blend-mode:screen}

.ka__label{position:absolute;z-index:2;top:calc(var(--hdr-h,76px) + 22px);inset-inline-start:clamp(20px,3vw,44px);display:flex;align-items:baseline;gap:14px;transition:opacity .6s ease;opacity:0}
.ka__num{font-family:"Frank Ruhl Libre",Georgia,serif;font-weight:300;font-size:clamp(40px,4.6vw,76px);line-height:.8;direction:ltr}
.ka__name{font-size:13px;letter-spacing:.14em;text-transform:uppercase;direction:ltr;color:rgba(236,230,220,.75)}
.ka__panel--2 .ka__label{inset-inline-start:auto;inset-inline-end:clamp(20px,3vw,44px)}

/* light: the room is dark, a soft light finds the looks */
.ka__veil{position:absolute;inset:0;z-index:2;pointer-events:none;background:rgba(6,6,6,.55);-webkit-backdrop-filter:grayscale(1) brightness(.42);backdrop-filter:grayscale(1) brightness(.42);
  -webkit-mask-image:radial-gradient(circle at var(--lx,50%) var(--ly,45%),transparent 0,transparent calc(var(--lr,0vmax) * .55),#000 var(--lr,0vmax));mask-image:radial-gradient(circle at var(--lx,50%) var(--ly,45%),transparent 0,transparent calc(var(--lr,0vmax) * .55),#000 var(--lr,0vmax));opacity:calc(1 - var(--p)*1.4)}
.ka__sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.ka__cue{position:absolute;z-index:4;left:50%;bottom:calc(22px + 38px);width:44px;height:44px;margin-left:-22px;display:grid;place-items:center;opacity:0}
.ka__cue i{display:block;width:1px;height:38px;background:linear-gradient(rgba(236,230,220,0),rgba(236,230,220,.85));transform-origin:top;animation:kaCue 2.4s cubic-bezier(.65,0,.35,1) infinite}
@keyframes kaCue{0%{transform:scaleY(0)}50%{transform:scaleY(1);transform-origin:top}51%{transform-origin:bottom}100%{transform:scaleY(0);transform-origin:bottom}}
.ka__cue:focus-visible{outline:1px solid var(--bone);outline-offset:4px}

/* cursor */
.ka__cursor{position:fixed;left:0;top:0;z-index:20;pointer-events:none;width:92px;height:92px;margin:-46px 0 0 -46px;border-radius:50%;border:1px solid rgba(236,230,220,.65);display:grid;place-items:center;font-size:12px;letter-spacing:.06em;color:var(--bone);backdrop-filter:blur(3px);-webkit-backdrop-filter:blur(3px);opacity:0;transform:scale(.6);transition:opacity .35s ease,transform .5s cubic-bezier(.22,1,.36,1)}
.ka.has-cursor .ka__cursor{opacity:1;transform:scale(1)}

.template-index .k-header:not(.is-scrolled):not(.is-open){background:transparent;color:#fff}

@media (max-width:749px){
  .ka{height:150vh}
  .ka__img{object-position:50% 12%}
  .ka__num{font-size:34px}.ka__name{display:none}
  .ka__cursor{display:none}
  .ka__panel{cursor:pointer}
}
@media (prefers-reduced-motion:reduce){
  .ka{height:auto}.ka__stage{position:relative}
  .ka__media{clip-path:none!important}.ka__label,.ka__cue{opacity:1!important}.ka__veil{display:none}
  .ka__panel{transform:none!important;transition:none}.ka__sheen{display:none}
}
</style>

<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js" defer></script>
<script>
(() => {
  const boot = () => {
    const root = document.getElementById('Atelier-{{ section.id }}');
    if (!root || root.dataset.ready) return; root.dataset.ready = 1;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const G = window.gsap;
    const q = s => root.querySelectorAll(s);
    const media = q('.ka__media'), imgs = q('.ka__img'), sheens = q('.ka__sheen');
    const show = () => { media.forEach(m => m.style.clipPath = 'none'); q('.ka__label,.ka__cue').forEach(e => e.style.opacity = 1); root.style.setProperty('--lr', '60vmax'); };
    if (!G) { show(); return; }

    // the light: position eases toward a target; when idle it drifts slowly between the two looks
    const L = { x: 50, y: 42, r: 0 }, T = { x: 50, y: 42 };
    let lastMove = 0, t0 = performance.now();
    const fine = matchMedia('(hover:hover) and (pointer:fine)').matches;
    const tick = now => {
      if (now - lastMove > 2200 || !fine) {               // idle drift: a slow figure-eight across both looks
        const t = (now - t0) / 1000;
        T.x = 50 + Math.sin(t * .32) * 26;
        T.y = 40 + Math.sin(t * .64) * 8;
      }
      L.x += (T.x - L.x) * .045; L.y += (T.y - L.y) * .045;
      root.style.setProperty('--lx', L.x.toFixed(2) + '%');
      root.style.setProperty('--ly', L.y.toFixed(2) + '%');
      root.style.setProperty('--lr', L.r.toFixed(2) + 'vmax');
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
    if (fine) root.addEventListener('pointermove', e => {
      const b = root.querySelector('.ka__stage').getBoundingClientRect();
      T.x = (e.clientX - b.left) / b.width * 100; T.y = (e.clientY - b.top) / b.height * 100; lastMove = performance.now();
    });

    const tl = G.timeline({ defaults: { ease: 'expo.out' } });
    // the shutter opens from a hairline, panel by panel
    tl.to(media, { clipPath: 'inset(0% 0 0% 0)', duration: 1.8, ease: 'expo.inOut', stagger: .18 }, 0)
      // they arrive from deep in the frame and keep walking in, slowly
      .fromTo(imgs, { scale: 1.32, yPercent: -3 }, { scale: 1.06, yPercent: 0, duration: 3.4, ease: 'power3.out', stagger: .18 }, .2)
      // the light comes up
      .to(L, { r: 30, duration: 2.6, ease: 'power2.out' }, 1.2)
      .to(q('.ka__label'), { opacity: 1, duration: 1, stagger: .15 }, 2.2)
      .to(q('.ka__cue'), { opacity: 1, duration: .8 }, 2.8)
      .add(() => {
        imgs.forEach((im, i) => G.to(im, { scale: 1.12, duration: 14 + i * 2, ease: 'sine.inOut', yoyo: true, repeat: -1 }));
        sheens.forEach((s, i) => G.fromTo(s, { xPercent: -60 }, { xPercent: 60, duration: 2.6, ease: 'power2.inOut', repeat: -1, repeatDelay: 7, delay: i * 1.3 }));
        G.to(L, { r: 34, duration: 3.5, ease: 'sine.inOut', yoyo: true, repeat: -1 });   // the light breathes
      }, 3.4);

    if (window.ScrollTrigger) {
      G.registerPlugin(ScrollTrigger);
      ScrollTrigger.create({ trigger: root, start: 'top top', end: 'bottom bottom', scrub: .8, onUpdate: s => root.style.setProperty('--p', s.progress.toFixed(4)) });
    }

    // cursor that reads the panel
    const cur = root.querySelector('.ka__cursor'), curTxt = cur.firstElementChild;
    if (matchMedia('(hover:hover) and (pointer:fine)').matches) {
      const xTo = G.quickTo(cur, 'x', { duration: .45, ease: 'power3' }), yTo = G.quickTo(cur, 'y', { duration: .45, ease: 'power3' });
      q('.ka__panel').forEach(p => {
        p.addEventListener('pointerenter', () => { curTxt.textContent = p.dataset.cursor || ''; root.classList.add('has-cursor'); });
        p.addEventListener('pointerleave', () => root.classList.remove('has-cursor'));
      });
      root.addEventListener('pointermove', e => { xTo(e.clientX); yTo(e.clientY); });
    }
  };
  if (document.readyState !== 'loading') boot(); else document.addEventListener('DOMContentLoaded', boot);
})();
</script>

{% schema %}
{"name":"פתיחה – אטלייה","tag":"div","settings":[
{"type":"image_picker","id":"image","label":"לוק 1"},
{"type":"text","id":"label1","label":"שם לוק 1","default":"Look 01"},
{"type":"url","id":"link1","label":"קישור לוק 1"},
{"type":"image_picker","id":"image2","label":"לוק 2"},
{"type":"text","id":"label2","label":"שם לוק 2","default":"Look 02"},
{"type":"url","id":"link2","label":"קישור לוק 2"},
{"type":"text","id":"wordmark","label":"לוגו","default":"KAV"},
{"type":"text","id":"headline","label":"כותרת","default":"פשוט להתלבש טוב."},
{"type":"text","id":"season","label":"שורה קטנה","default":"חורף 2026"},
{"type":"text","id":"btn_label","label":"כפתור","default":"לראות מה יש"},
{"type":"url","id":"btn_link","label":"קישור הכפתור"},
{"type":"text","id":"cursor","label":"טקסט בעיגול העכבר","default":"לצפייה"},
{"type":"text","id":"reveal","label":"משפט שמתגלה בגלילה","default":"מעט פריטים. כל אחד נבחר כי הוא נראה טוב עליך."}],
"presets":[{"name":"פתיחה – אטלייה"}]}
{% endschema %}
