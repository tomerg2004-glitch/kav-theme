<nav class="k-catnav" aria-label="{{ 'collections.categories' | t }}">
  <div class="k-wrap k-catnav__row">
    {%- for link in section.settings.menu.links -%}
      {%- if link.type == 'collection_link' and link.object.products_count == 0 -%}{%- continue -%}{%- endif -%}
      {%- assign on = false -%}{%- if template.name == 'collection' and link.type == 'collection_link' and link.object.handle == collection.handle -%}{%- assign on = true -%}{%- endif -%}{%- if template.name == 'collection' and link.url == '/collections/all' and collection.handle == 'all' -%}{%- assign on = true -%}{%- endif -%}
      <a class="k-chip{% if on %} is-on{% endif %}"{% if on %} aria-current="page"{% endif %} href="{% if link.type == 'collection_link' and template.name == 'index' %}#cat-{{ link.object.handle }}{% else %}{{ link.url }}{% endif %}">{{ link.title }}</a>
    {%- endfor -%}
    <span class="k-chip-ink" aria-hidden="true"></span>
  </div>
</nav>
{% schema %}
{"name":"ניווט קטגוריות","tag":"div","settings":[{"type":"link_list","id":"menu","label":"תפריט","default":"main-menu"}],"presets":[{"name":"ניווט קטגוריות"}]}
{% endschema %}
