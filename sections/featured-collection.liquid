{%- liquid
  assign col = section.settings.collection
  if col == blank
    assign col = collections.all
  endif
-%}
<section class="k-wrap k-section" aria-labelledby="H-{{ section.id }}">
  <div class="k-sechead">
    <div style="display:flex;flex-direction:column;gap:14px">
      {%- if section.settings.eyebrow != blank -%}<p class="k-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 id="H-{{ section.id }}" class="k-display k-h2">{{ section.settings.title }}</h2>
    </div>
    <div style="display:flex;flex-direction:column;gap:14px;align-items:flex-start">
      {%- if section.settings.text != blank -%}<p class="k-lead">{{ section.settings.text }}</p>{%- endif -%}
      <a class="k-link" href="{{ col.url | default: routes.all_products_collection_url }}">{{ section.settings.link_label }}</a>
    </div>
  </div>
  <div class="k-grid">
    {%- for product in col.products limit: section.settings.limit -%}
      {% render 'product-card', product: product %}
    {%- else -%}
      {%- for i in (1..4) -%}<div class="k-pcard"><div class="k-pcard__media">{{ 'product-1' | placeholder_svg_tag: 'k-placeholder' }}</div></div>{%- endfor -%}
    {%- endfor -%}
  </div>
</section>
{% schema %}
{"name":"רשת מוצרים","tag":"div","settings":[{"type":"text","id":"eyebrow","label":"שורה קטנה","default":"הקולקציה"},{"type":"text","id":"title","label":"כותרת","default":"מהדורה 01"},{"type":"textarea","id":"text","label":"טקסט","default":"ארבעה פריטים. כל אחד עומד בפני עצמו, וכולם מתחברים זה לזה."},{"type":"text","id":"link_label","label":"טקסט קישור","default":"לכל המוצרים"},{"type":"collection","id":"collection","label":"קולקציה (ריק = כל המוצרים)"},{"type":"range","id":"limit","label":"כמה מוצרים","min":2,"max":12,"step":1,"default":4}],"presets":[{"name":"רשת מוצרים"}]}
{% endschema %}
