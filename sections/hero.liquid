<section class="k-hero1{% if section.settings.dark %} k-hero1--dark{% endif %}" aria-labelledby="Hero-{{ section.id }}">
  <div class="k-hero1__img{% if section.settings.image2 %} k-hero1__img--duo{% endif %}">
    {%- if section.settings.image -%}
      <a class="k-hero1__fig" href="{{ section.settings.link1 | default: '#look-1' }}" aria-label="{{ section.settings.label1 | escape }}">{{ section.settings.image | image_url: width: 1600 | image_tag: widths: '600,900,1200,1600', sizes: '(min-width: 750px) 50vw, 100vw', fetchpriority: 'high', alt: section.settings.image.alt | default: section.settings.alt }}</a>
    {%- else -%}
      <img src="{{ section.settings.asset | asset_url }}" width="900" height="1125" fetchpriority="high" alt="{{ section.settings.alt | escape }}">
    {%- endif -%}
    {%- if section.settings.image2 -%}
      <a class="k-hero1__fig" href="{{ section.settings.link2 | default: '#look-2' }}" aria-label="{{ section.settings.label2 | escape }}">{{ section.settings.image2 | image_url: width: 1600 | image_tag: widths: '600,900,1200,1600', sizes: '50vw', alt: section.settings.image2.alt }}</a>
    {%- endif -%}
  </div>
  <div class="k-hero1__shade" aria-hidden="true"></div>
  <div class="k-wrap k-hero1__text">
    <h1 id="Hero-{{ section.id }}" class="k-display k-hero1__h1"><span class="l"><span>{{ section.settings.line1 }}</span></span>{%- if section.settings.line2 != blank -%}<span class="l"><span>{{ section.settings.line2 }}</span></span>{%- endif -%}</h1>
    <div class="k-hero1__foot">
      {%- if section.settings.fact != blank -%}<p class="k-hero1__fact">{{ section.settings.fact }}</p>{%- endif -%}
      {%- if section.settings.btn_label != blank -%}<a class="k-btn k-btn--light" href="{{ section.settings.btn_link | default: '#cat-shoes' }}">{{ section.settings.btn_label }}</a>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{"name":"פתיחה","tag":"div","settings":[
{"type":"image_picker","id":"image","label":"תמונה"},{"type":"image_picker","id":"image2","label":"תמונה שנייה (לוק 2)"},{"type":"text","id":"label1","label":"שם לוק 1","default":"לוק 1: חרמון ויפו"},{"type":"url","id":"link1","label":"קישור לוק 1"},{"type":"text","id":"label2","label":"שם לוק 2","default":"לוק 2: בוסטון ורמון"},{"type":"url","id":"link2","label":"קישור לוק 2"},{"type":"text","id":"asset","label":"תמונה מהתבנית (אם לא נבחרה)","default":"kav-plaid-2.jpg"},{"type":"checkbox","id":"dark","label":"רקע שחור, הדמות יוצאת מהחושך","default":true},
{"type":"text","id":"alt","label":"תיאור התמונה","default":"גבר באוברשירט חרמון מעל טי-שירט לבנה"},
{"type":"text","id":"focus","label":"מיקוד התמונה (CSS)","default":"50% 22%"},
{"type":"text","id":"line1","label":"כותרת שורה 1","default":"בגדי רחוב"},
{"type":"text","id":"line2","label":"כותרת שורה 2","default":"לגברים."},
{"type":"text","id":"fact","label":"שורת מידע","default":"נעליים, מכנסיים ומכופתרות · ₪150–₪290 · ביטול עסקה עד 14 יום"},
{"type":"text","id":"btn_label","label":"כפתור","default":"לקטלוג"},
{"type":"url","id":"btn_link","label":"קישור"}],
"presets":[{"name":"פתיחה"}]}
{% endschema %}
