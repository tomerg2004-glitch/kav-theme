{%- liquid
  assign img1 = section.settings.image1
  assign img2 = section.settings.image2
-%}
<section class="k-hero" aria-labelledby="Hero-{{ section.id }}">
  <div class="k-hero__img">
    {%- if img1 -%}
      {{ img1 | image_url: width: 1600 | image_tag: widths: '700,1100,1600', sizes: '(min-width: 750px) 50vw, 100vw', fetchpriority: 'high', alt: img1.alt | default: section.settings.alt1 }}
    {%- else -%}
      <img src="{{ section.settings.asset1 | asset_url }}" width="900" height="1125" fetchpriority="high" alt="{{ section.settings.alt1 | escape }}">
    {%- endif -%}
  </div>
  <div class="k-hero__img">
    {%- if img2 -%}
      {{ img2 | image_url: width: 1600 | image_tag: widths: '700,1100,1600', sizes: '50vw', loading: 'lazy', alt: img2.alt | default: section.settings.alt2 }}
    {%- else -%}
      <img src="{{ section.settings.asset2 | asset_url }}" width="900" height="1125" alt="{{ section.settings.alt2 | escape }}">
    {%- endif -%}
  </div>
  <div class="k-hero__shade" aria-hidden="true"></div>
  <div class="k-hero__text">
    <div class="k-wrap k-hero__inner">
      <div class="k-hero__copy">
        {%- if section.settings.eyebrow != blank -%}<p class="k-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h1 id="Hero-{{ section.id }}" class="k-display k-h1 k-hero__h1">
          <span class="l"><span>{{ section.settings.line1 }}</span></span>
          {%- if section.settings.line2 != blank -%}<span class="l"><span>{{ section.settings.line2 }}</span></span>{%- endif -%}
        </h1>
        {%- if section.settings.text != blank -%}<p class="k-lead">{{ section.settings.text }}</p>{%- endif -%}
      </div>
      <div class="k-hero__side">
        {%- if section.settings.facts != blank -%}
        <ul class="k-hero__facts">
          {%- assign facts = section.settings.facts | split: '|' -%}
          {%- for f in facts -%}{%- assign kv = f | split: ':' -%}<li><span>{{ kv[0] | strip }}</span><span>{{ kv[1] | strip }}</span></li>{%- endfor -%}
        </ul>
        {%- endif -%}
        <div class="k-hero__actions">
          {%- if section.settings.btn1_label != blank -%}<a class="k-btn k-btn--light" href="{{ section.settings.btn1_link | default: routes.all_products_collection_url }}">{{ section.settings.btn1_label }}</a>{%- endif -%}
          {%- if section.settings.btn2_label != blank -%}<a class="k-btn k-btn--ghost" href="{{ section.settings.btn2_link | default: '/products/contrast-01' }}">{{ section.settings.btn2_label }}</a>{%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{"name":"פתיחה","tag":"div","settings":[
{"type":"image_picker","id":"image1","label":"תמונה 1"},
{"type":"text","id":"asset1","label":"תמונה 1 מהתבנית (אם לא נבחרה)","default":"kav-camo-1.jpg"},
{"type":"text","id":"alt1","label":"תיאור תמונה 1","default":"גבר בג'ינס רחב בהדפס הסוואה וסניקרס שחור-לבן"},
{"type":"image_picker","id":"image2","label":"תמונה 2"},
{"type":"text","id":"asset2","label":"תמונה 2 מהתבנית (אם לא נבחרה)","default":"kav-plaid-2.jpg"},
{"type":"text","id":"alt2","label":"תיאור תמונה 2","default":"גבר באוברשירט משבצות בגווני בז' ואפור"},
{"type":"text","id":"eyebrow","label":"שורה קטנה","default":"מהדורה 01 · סתיו 2026"},
{"type":"text","id":"line1","label":"כותרת שורה 1","default":"בגדי רחוב לגברים."},
{"type":"text","id":"line2","label":"כותרת שורה 2","default":"מעט פריטים, הרבה שילובים."},
{"type":"textarea","id":"text","label":"טקסט","default":"ג'ינס רחב, אוברשירט משבצות, שורט ג'ינס וסניקרס עור. ארבעה פריטים שנבחרו כדי ללכת יחד."},
{"type":"text","id":"facts","label":"עובדות (נושא: ערך, מופרדות ב-|)","default":"מחירים: ₪156–₪290 | מידות בגדים: XS–XXL | מידות נעליים: 40–47 | ביטול עסקה: עד 14 יום"},
{"type":"text","id":"btn1_label","label":"כפתור ראשי","default":"לכל המהדורה"},
{"type":"url","id":"btn1_link","label":"קישור כפתור ראשי"},
{"type":"text","id":"btn2_label","label":"כפתור משני","default":"לסניקרס לבונטין"},
{"type":"url","id":"btn2_link","label":"קישור כפתור משני"}],
"presets":[{"name":"פתיחה"}]}
{% endschema %}
