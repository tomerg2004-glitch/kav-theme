{%- assign p = section.settings.product -%}
<section class="k-spot k-section" aria-labelledby="H-{{ section.id }}">
  <div class="k-wrap k-spot__grid">
    {%- liquid
      assign color_idx = nil
      if p != blank
        for o in p.options_with_values
          assign on = o.name | downcase
          if on == 'צבע' or on == 'color'
            assign color_idx = forloop.index0
          endif
        endfor
      endif
    -%}
    <div class="k-spot__media" data-swatch-stage>
      <div class="k-spot__stage">
        {%- if color_idx != nil -%}
          {%- assign seen = '' -%}
          {%- for v in p.variants -%}
            {%- assign cname = v.options[color_idx] -%}
            {%- assign key = '|' | append: cname | append: '|' -%}
            {%- unless seen contains key -%}{%- if v.featured_media -%}
              {%- assign seen = seen | append: key -%}
              <img src="{{ v.featured_media | image_url: width: 1400 }}" srcset="{{ v.featured_media | image_url: width: 700 }} 700w, {{ v.featured_media | image_url: width: 1400 }} 1400w" sizes="(min-width: 900px) 55vw, 100vw" alt="{{ p.title | escape }}, {{ cname | escape }}" width="{{ v.featured_media.width }}" height="{{ v.featured_media.height }}" loading="lazy" data-swatch-img="{{ cname | escape }}"{% if seen == key %} class="is-on"{% endif %}>
            {%- endif -%}{%- endunless -%}
          {%- endfor -%}
        {%- elsif section.settings.image -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'is-on', alt: section.settings.alt }}
        {%- else -%}
          <img class="is-on" src="{{ section.settings.asset | asset_url }}" width="1600" height="1280" loading="lazy" alt="{{ section.settings.alt | escape }}">
        {%- endif -%}
      </div>
      {%- if color_idx != nil -%}
      <div class="k-spot__swatches">
        <div class="k-swatches" role="radiogroup" aria-label="{{ 'products.color' | t }}">
          {%- assign seen = '' -%}
          {%- for v in p.variants -%}
            {%- assign cname = v.options[color_idx] -%}
            {%- assign key = '|' | append: cname | append: '|' -%}
            {%- unless seen contains key -%}{%- if v.featured_media -%}
              {%- assign seen = seen | append: key -%}
              <button type="button" class="k-sw" role="radio" aria-checked="{% if seen == key %}true{% else %}false{% endif %}" aria-label="{{ cname | escape }}" data-swatch="{{ cname | escape }}"><span style="background-image:url({{ v.featured_media | image_url: width: 120 }})"></span></button>
            {%- endif -%}{%- endunless -%}
          {%- endfor -%}
        </div>
        <p class="k-spot__colorname" aria-live="polite"><span data-swatch-label>{{ p.variants.first.options[color_idx] }}</span> · {{ p.options_with_values[color_idx].values.size }} {{ 'products.colors' | t }}</p>
      </div>
      {%- endif -%}
    </div>
    <div class="k-spot__body">
      <h2 id="H-{{ section.id }}" class="k-display k-h2">{{ section.settings.title }}</h2>
      {%- if section.settings.text != blank -%}<p class="k-lead">{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.blocks.size > 0 -%}
      <ul class="k-spot__list">
        {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}><strong>{{ block.settings.title }}</strong><span>{{ block.settings.text }}</span></li>
        {%- endfor -%}
      </ul>
      {%- endif -%}
      <div class="k-spot__buy">
        {%- if p != blank -%}<span class="k-spot__price">{{ p.price_min | money_without_trailing_zeros }}</span>{%- endif -%}
        <a class="k-btn k-btn--light" href="{{ p.url | default: section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.btn_label }}</a>
      </div>
    </div>
  </div>
</section>
{% schema %}
{"name":"מוצר בפוקוס","tag":"div","settings":[
{"type":"product","id":"product","label":"מוצר"},
{"type":"url","id":"link","label":"קישור (אם לא נבחר מוצר)"},
{"type":"image_picker","id":"image","label":"תמונה"},
{"type":"text","id":"asset","label":"תמונה מהתבנית (אם לא נבחרה)","default":"kav-shoe-1-wide.jpg"},
{"type":"text","id":"alt","label":"תיאור התמונה","default":"סניקרס לבונטין בשחור ושמנת, מבט מהצד"},
{"type":"text","id":"eyebrow","label":"שורה קטנה","default":"נעליים"},
{"type":"text","id":"title","label":"כותרת","default":"לבונטין"},
{"type":"textarea","id":"text","label":"טקסט","default":"סניקרס נמוכה בשחור ושמנת. קווים נקיים, ושלושה פרטים שעושים את ההבדל."},
{"type":"text","id":"btn_label","label":"כפתור","default":"לבחור מידה"}],
"blocks":[{"type":"point","name":"פרט","limit":4,"settings":[{"type":"text","id":"title","label":"כותרת"},{"type":"text","id":"text","label":"טקסט"}]}],
"presets":[{"name":"מוצר בפוקוס"}]}
{% endschema %}
