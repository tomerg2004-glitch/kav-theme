<section class="k-wrap k-section" aria-labelledby="H-{{ section.id }}">
  <div class="k-sechead">
    <h2 id="H-{{ section.id }}" class="k-display k-h2">{{ section.settings.title }}</h2>
    {%- if section.settings.text != blank -%}<p class="k-lead">{{ section.settings.text }}</p>{%- endif -%}
  </div>
  <div class="k-grid">
    {%- for block in section.blocks -%}
      <a class="k-card k-tile k-tile--sq" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
        {%- if block.settings.image -%}{{ block.settings.image | image_url: width: 1100 | image_tag: class: 'k-ph', loading: 'lazy', widths: '540,800,1100', sizes: '(min-width: 990px) 50vw, 100vw' }}{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'k-placeholder' }}{%- endif -%}
      </a>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{"name":"זוג תמונות","tag":"div","settings":[{"type":"text","id":"title","label":"כותרת","default":"על הרגל"},{"type":"textarea","id":"text","label":"טקסט","default":"סוליה מוגבהת שמוסיפה סנטימטרים, ושרוכים שרואים מרחוק."}],"blocks":[{"type":"image","name":"תמונה","limit":3,"settings":[{"type":"image_picker","id":"image","label":"תמונה"},{"type":"url","id":"link","label":"קישור"}]}],"presets":[{"name":"זוג תמונות","blocks":[{"type":"image"},{"type":"image"}]}]}
{% endschema %}
