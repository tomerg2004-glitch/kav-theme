{%- assign col = section.settings.collection -%}
{%- if col != blank and col.products_count > 0 -%}
<section class="k-wrap k-cat" id="cat-{{ col.handle }}" aria-labelledby="H-{{ section.id }}">
  <div class="k-cat__head">
    <h2 id="H-{{ section.id }}" class="k-display k-h2">{{ col.title }}</h2>
    <div class="k-cat__nav">
      <button type="button" class="k-cat__arrow" data-dir="-1" aria-label="הקודם" aria-controls="R-{{ section.id }}"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.4"/></svg></button>
      <button type="button" class="k-cat__arrow" data-dir="1" aria-label="הבא" aria-controls="R-{{ section.id }}"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.4"/></svg></button>
      <a class="k-link" href="{{ col.url }}">{{ 'collections.view_all' | t }} ({{ col.products_count }})</a>
    </div>
  </div>
  <div class="k-rail" id="R-{{ section.id }}" tabindex="0" aria-label="{{ col.title | escape }}">
    {%- for product in col.products limit: 12 -%}{% render 'product-cards', product: product %}{%- endfor -%}
  </div>
</section>
<style>
#cat-{{ col.handle }} .k-cat__nav{display:flex;align-items:center;gap:10px}
#cat-{{ col.handle }} .k-cat__arrow{width:40px;height:40px;border-radius:50%;border:1px solid currentColor;background:none;color:inherit;display:grid;place-items:center;cursor:pointer;opacity:.55;transition:opacity .25s,background .25s,color .25s}
#cat-{{ col.handle }} .k-cat__arrow:hover{opacity:1;background:#111;color:#f1ede6}
#cat-{{ col.handle }} .k-cat__arrow[disabled]{opacity:.15;cursor:default;background:none;color:inherit}
#cat-{{ col.handle }} .k-rail{display:grid;grid-auto-flow:column;grid-auto-columns:calc((100% - 3 * 20px) / 4);gap:20px;overflow-x:auto;overscroll-behavior-x:contain;scroll-snap-type:x mandatory;scrollbar-width:none;padding-bottom:4px}
#cat-{{ col.handle }} .k-rail::-webkit-scrollbar{display:none}
#cat-{{ col.handle }} .k-rail>*{scroll-snap-align:start;min-width:0}
#cat-{{ col.handle }} .k-rail:focus-visible{outline:1px solid currentColor;outline-offset:6px}
@media (max-width:989px){#cat-{{ col.handle }} .k-rail{grid-auto-columns:calc((100% - 2 * 16px) / 2.6);gap:16px}}
@media (max-width:749px){#cat-{{ col.handle }} .k-rail{grid-auto-columns:68%;gap:12px}#cat-{{ col.handle }} .k-cat__arrow{display:none}}
@media (prefers-reduced-motion:no-preference){#cat-{{ col.handle }} .k-rail{scroll-behavior:smooth}}
</style>
<script>
(function(){var sec=document.getElementById('cat-{{ col.handle }}');if(!sec)return;var r=sec.querySelector('.k-rail'),b=sec.querySelectorAll('.k-cat__arrow');
var rtl=getComputedStyle(r).direction==='rtl';
function upd(){var x=Math.abs(r.scrollLeft),m=r.scrollWidth-r.clientWidth-2;b[0].disabled=x<=2;b[1].disabled=x>=m;}
b.forEach(function(btn){btn.addEventListener('click',function(){var d=+btn.dataset.dir*(rtl?-1:1);r.scrollBy({left:d*r.clientWidth*.9});});});
r.addEventListener('scroll',upd,{passive:true});window.addEventListener('resize',upd);upd();})();
</script>
{%- endif -%}
{% schema %}
{"name":"קטגוריה","tag":"div","settings":[{"type":"collection","id":"collection","label":"קולקציה"}],"presets":[{"name":"קטגוריה"}]}
{% endschema %}
