{"type":"textarea","id":"text","label":"המשפט (12–40 מילים, אפשר <strong> למילים מודגשות)","default":"אנחנו לא מוציאים מאות דגמים. כל מהדורה של KAV קטנה ומדויקת: גזרות רחבות, בדים עם אופי וצבעים שמשתלבים זה בזה, כך ש<strong>כל פריט מוצא לעצמו בן זוג</strong> בארון."}],
"presets":[{"name":"משפט מרכזי"}]}
{% endschema %}
