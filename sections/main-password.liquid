<div class="k-wrap" style="min-height:100vh;display:flex;flex-direction:column;justify-content:center;gap:24px;padding-block:64px">
  <span class="k-logo">{{ shop.name }}</span>
  <h1 class="k-display k-h1">{{ 'password.title' | t }}</h1>
  {%- if shop.password_message != blank -%}<p class="k-lead">{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'customer' -%}<input type="hidden" name="contact[tags]" value="prelaunch"><div class="k-news__row" style="max-width:560px"><label for="PwEmail" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">{{ 'newsletter.email' | t }}</label><input id="PwEmail" class="k-input" type="email" name="contact[email]" required dir="ltr" placeholder="name@example.com" style="text-align:start"><button class="k-btn k-btn--dark" type="submit">{{ 'password.notify' | t }}</button></div>{%- if form.posted_successfully? -%}<p class="k-msg" role="status">{{ 'newsletter.success' | t }}</p>{%- endif -%}<p class="k-consent" style="max-width:560px">בהרשמה את/ה מסכים/ה לקבל מ-KAV מיילים עם עדכונים ופרסומות. אפשר להסיר את עצמך בכל רגע. <a href="/pages/privacy">מדיניות הפרטיות</a></p>{%- endform -%}
  <details><summary style="cursor:pointer;min-height:44px">{{ 'password.owner' | t }}</summary>{%- form 'storefront_password' -%}<div class="k-news__row" style="max-width:560px;margin-top:12px"><label for="PwPass" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">{{ 'password.password' | t }}</label><input id="PwPass" class="k-input" type="password" name="password" autocomplete="current-password"><button class="k-btn k-btn--line" type="submit">{{ 'password.enter' | t }}</button></div>{{ form.errors | default_errors }}{%- endform -%}</details>
</div>
{% schema %}{"name":"עמוד סיסמה"}{% endschema %}
