<section class="k-service" aria-label="{{ section.settings.label | escape }}">
  <div class="k-wrap">
    <ul class="k-service__list">
      {%- for block in section.blocks -%}
      <li {{ block.shopify_attributes }}>{% render 'icon', name: block.settings.icon %}<span><strong>{{ block.settings.title }}</strong><span>{{ block.settings.text }}</span></span></li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{% schema %}
{"name":"שירות","tag":"div","settings":[{"type":"text","id":"label","label":"שם האזור (לקוראי מסך)","default":"משלוח, החזרות ותשלום"}],
"blocks":[{"type":"item","name":"פריט","limit":4,"settings":[{"type":"select","id":"icon","label":"אייקון","default":"truck","options":[{"value":"truck","label":"משלוח"},{"value":"return","label":"החזרה"},{"value":"lock","label":"מנעול"}]},{"type":"text","id":"title","label":"כותרת","default":"משלוח עד הבית"},{"type":"text","id":"text","label":"טקסט","default":"עם מספר מעקב לכל הזמנה."}]}],
"presets":[{"name":"שירות"}]}
{% endschema %}
