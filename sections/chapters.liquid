<section class="k-ch" data-chapters aria-labelledby="H-{{ section.id }}">
  <div class="k-wrap k-ch__box">
    <div class="k-ch__head">
      <h2 id="H-{{ section.id }}" class="k-display k-h2">{{ section.settings.title }}</h2>
      {%- if section.settings.text != blank -%}<p class="k-lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <ol class="k-ch__list">
      {%- for block in section.blocks -%}
      <li class="k-ch__item" {{ block.shopify_attributes }}>
        <figure class="k-ch__pic">
          {%- if block.settings.image -%}
            {{ block.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '700,1100,1500,1800', sizes: '100vw', alt: block.settings.alt }}
          {%- else -%}
            <img src="{{ block.settings.asset | asset_url }}" width="900" height="1125" loading="lazy" alt="{{ block.settings.alt | escape }}">
          {%- endif -%}
        </figure>
        <div class="k-ch__words">
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
          {%- if block.settings.link != blank -%}<a class="k-link" href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>{%- endif -%}
        </div>
      </li>
      {%- endfor -%}
    </ol>
  </div>
</section>
{% schema %}
{"name":"פרקי תמונות","tag":"div","settings":[
{"type":"text","id":"title","label":"כותרת","default":"איך לובשים את מהדורה 01"},
{"type":"text","id":"text","label":"טקסט","default":"כל פריט עובד לבד, ועוד יותר טוב עם השאר."}],
"blocks":[{"type":"chapter","name":"פרק","limit":5,"settings":[
{"type":"image_picker","id":"image","label":"תמונה"},
{"type":"text","id":"asset","label":"תמונה מהתבנית (אם לא נבחרה)"},
{"type":"text","id":"alt","label":"תיאור התמונה"},
{"type":"text","id":"title","label":"כותרת"},
{"type":"textarea","id":"text","label":"טקסט"},
{"type":"url","id":"link","label":"קישור"},
{"type":"text","id":"link_label","label":"טקסט קישור"}]}],
"presets":[{"name":"פרקי תמונות"}]}
{% endschema %}
