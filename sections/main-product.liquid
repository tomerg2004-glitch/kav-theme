{%- liquid
  assign current = product.selected_or_first_available_variant
  assign start_media = current.featured_media | default: product.featured_media
  assign has_options = true
  if product.has_only_default_variant
    assign has_options = false
  endif
-%}
<div class="k-wrap" data-product data-added-msg="{{ 'products.added_title' | t }}" data-cart-label="{{ 'products.view_cart' | t }}" data-cart-url="{{ routes.cart_url }}">
<script type="application/json" data-product-json>{{ product | json }}</script>
<section class="k-product" aria-labelledby="ProductTitle-{{ section.id }}">
  <div class="k-product__media">
    <div class="k-product__stage{% if section.settings.fit == 'contain' %} k-product__stage--contain{% endif %}" style="--ratio:{{ section.settings.ratio }};{% if section.settings.fit == 'contain' %}background:var(--paper){% endif %}">
      {%- for media in product.media -%}
        {%- if media.media_type == 'image' -%}
        <img src="{{ media | image_url: width: 1400 }}" srcset="{{ media | image_url: width: 700 }} 700w, {{ media | image_url: width: 1100 }} 1100w, {{ media | image_url: width: 1400 }} 1400w" sizes="(min-width: 990px) 55vw, 100vw" width="{{ media.width }}" height="{{ media.height }}" alt="{{ media.alt | default: product.title | escape }}" data-media-id="{{ media.id }}"{% if media.id == start_media.id %} class="is-on"{% else %} loading="lazy"{% endif %}>
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'k-placeholder' }}
      {%- endfor -%}
    </div>
    {%- if product.media.size > 1 and section.settings.show_thumbs -%}
    <div class="k-thumbs" role="group" aria-label="{{ 'products.images' | t }}">
      {%- for media in product.media -%}{%- if media.media_type == 'image' -%}
        <button type="button" class="k-thumb{% if media.id == start_media.id %} is-on{% endif %}" data-thumb="{{ media.id }}" aria-pressed="{% if media.id == start_media.id %}true{% else %}false{% endif %}" aria-label="{{ 'products.image_n' | t: n: forloop.index }}">{{ media | image_url: width: 160 | image_tag: alt: '' , loading: 'lazy' }}</button>
      {%- endif -%}{%- endfor -%}
    </div>
    {%- endif -%}
  </div>

  <div class="k-product__info">
    <nav class="k-crumbs" aria-label="{{ 'products.breadcrumbs' | t }}"><a class="k-u" href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>{% if collection %} / <a class="k-u" href="{{ collection.url }}">{{ collection.title }}</a>{% endif %} / {{ product.title }}</nav>
    <div style="display:flex;flex-direction:column;gap:8px">
      <h1 id="ProductTitle-{{ section.id }}" class="k-display k-product__title">{{ product.title }}</h1>
      {%- if product.metafields.custom.subtitle != blank -%}<p class="k-lead" style="font-size:18px">{{ product.metafields.custom.subtitle }}</p>{%- endif -%}
    </div>
    <p class="k-product__price"><span data-price>{{ current.price | money_without_trailing_zeros }}</span>{% if current.compare_at_price > current.price %}<s>{{ current.compare_at_price | money_without_trailing_zeros }}</s>{% endif %}</p>

    {%- form 'product', product, novalidate: 'novalidate' -%}
      <input type="hidden" name="id" value="{{ current.id }}">
      {%- if has_options -%}
      {%- for option in product.options_with_values -%}
        {%- liquid
          assign oname = option.name | downcase
          assign is_color = false
          if oname == 'צבע' or oname == 'color' or oname == 'colour'
            assign is_color = true
          endif
          assign is_size = false
          if oname == 'מידה' or oname == 'size'
            assign is_size = true
          endif
          assign oi = forloop.index0
        -%}
        <fieldset class="k-fieldset">
          <legend><span style="font-weight:500">{{ option.name }}:</span> <span data-opt-label="{{ oi }}">{% unless is_size %}{{ option.selected_value }}{% endunless %}</span></legend>
          <div class="{% if is_color %}k-swatches{% else %}k-sizes{% endif %}" role="radiogroup" aria-label="{{ option.name | escape }}">
          {%- for value in option.values -%}
            {%- liquid
              assign checked = false
              unless is_size
                if option.selected_value == value
                  assign checked = true
                endif
              endunless
            -%}
            {%- if is_color -%}
              {%- liquid
                assign sw_img = nil
                for v in product.variants
                  if v.options[oi] == value and v.featured_media
                    assign sw_img = v.featured_media
                    break
                  endif
                endfor
              -%}
              <button type="button" class="k-sw" role="radio" aria-checked="{{ checked }}" aria-label="{{ value | escape }}" data-opt="{{ oi }}" data-value="{{ value | escape }}"><span style="{% if sw_img %}background-image:url({{ sw_img | image_url: width: 120 }}){% else %}background:var(--card){% endif %}"></span></button>
            {%- else -%}
              <button type="button" class="k-size" role="radio" aria-checked="{{ checked }}" data-opt="{{ oi }}" data-value="{{ value | escape }}">{{ value }}</button>
            {%- endif -%}
          {%- endfor -%}
          </div>
        </fieldset>
      {%- endfor -%}
      {%- endif -%}
      <p class="k-msg k-msg--err" role="alert" data-error hidden>{{ 'products.choose_size' | t }}</p>
      <div style="display:flex;flex-direction:column;gap:12px;margin-top:6px">
        <button type="submit" class="k-btn k-btn--dark k-btn--block" data-add data-label-add="{{ 'products.add' | t }}" data-label-added="{{ 'products.added' | t }}" data-label-sold="{{ 'products.sold_out' | t }}" data-label-error="{{ 'products.error' | t }}"{% unless current.available %} disabled{% endunless %}>{% if current.available %}{{ 'products.add' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}</button>
      </div>
    {%- endform -%}

    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when '@app' -%}{% render block %}
        {%- when 'tryon' -%}
          {%- if block.settings.link != blank -%}<a class="k-btn k-btn--line k-btn--block" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{% render 'icon', name: 'user' %}{{ block.settings.label }}</a>{%- endif -%}
        {%- when 'perks' -%}
          <ul class="k-perks" {{ block.shopify_attributes }}>
            {%- assign ship = product.metafields.custom.shipping_note | default: block.settings.shipping -%}{%- if ship != blank -%}<li>{% render 'icon', name: 'truck' %}<span>{{ ship }}</span></li>{%- endif -%}
            {%- if block.settings.returns != blank -%}<li>{% render 'icon', name: 'return' %}<span>{{ block.settings.returns }}</span></li>{%- endif -%}
          </ul>
        {%- when 'fit_note' -%}
          <p class="k-sub" {{ block.shopify_attributes }}>{{ product.metafields.custom.fit_note | default: block.settings.text }}</p>
        {%- when 'description' -%}
          {%- if product.description != blank -%}<div class="k-rte" {{ block.shopify_attributes }}>{{ product.description }}</div>{%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>
<div class="k-buybar" data-buybar aria-hidden="true"><span class="k-buybar__price">{{ current.price | money_without_trailing_zeros }}</span><button type="button" class="k-btn k-btn--dark" tabindex="-1">{{ 'products.choose_and_add' | t }}</button></div>
</div>
{% schema %}
{"name":"עמוד מוצר","tag":"div","settings":[
{"type":"select","id":"ratio","label":"יחס תמונה","default":"1","options":[{"value":"1","label":"ריבוע (נעליים)"},{"value":"3/4","label":"לאורך (ביגוד)"}]},
{"type":"select","id":"fit","label":"התאמת תמונה","default":"cover","options":[{"value":"cover","label":"מילוי"},{"value":"contain","label":"התאמה (מבט צד)"}]},
{"type":"checkbox","id":"show_thumbs","label":"להציג תמונות קטנות","default":true}],
"blocks":[{"type":"@app"},
{"type":"tryon","name":"כפתור תמדוד עליי","limit":1,"settings":[{"type":"text","id":"label","label":"טקסט","default":"תמדוד עליי"},{"type":"url","id":"link","label":"קישור (אם לא משתמשים באפליקציה)"}]},
{"type":"fit_note","name":"הערת גזרה","limit":1,"settings":[{"type":"text","id":"text","label":"טקסט ברירת מחדל","default":"בין שתי מידות? כדאי לבחור את הגדולה."}]},
{"type":"perks","name":"משלוח והחזרות","limit":1,"settings":[{"type":"text","id":"shipping","label":"משלוח","default":"משלוח עד הבית, עם מספר מעקב."},{"type":"text","id":"returns","label":"החזרות","default":"החזרה חינם תוך 14 יום מקבלת המשלוח."}]},
{"type":"description","name":"תיאור","limit":1}]}
{% endschema %}
