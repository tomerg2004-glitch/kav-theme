<section class="k-section" style="border-top:1px solid var(--line)" aria-labelledby="H-{{ section.id }}">
  <div class="k-wrap k-news">
    <div style="flex:1 1 480px;display:flex;flex-direction:column;gap:20px">
      {%- if section.settings.eyebrow != blank -%}<p class="k-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 id="H-{{ section.id }}" class="k-display k-h2">{{ section.settings.title }}</h2>
      {%- if section.settings.text != blank -%}<p class="k-lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    {%- assign news_form_id = 'Newsletter-' | append: section.id -%}
    {%- form 'customer', id: news_form_id -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label for="NewsEmail-{{ section.id }}">{{ 'newsletter.email' | t }}</label>
      <div class="k-news__row">
        <input id="NewsEmail-{{ section.id }}" class="k-input" type="email" name="contact[email]" required autocomplete="email" dir="ltr" placeholder="name@example.com" style="text-align:start">
        <button class="k-btn k-btn--dark" type="submit">{{ section.settings.button }}</button>
      </div>
      {%- if form.posted_successfully? -%}<p class="k-msg" role="status">{{ 'newsletter.success' | t }}</p>{%- endif -%}
      {%- if form.errors -%}<p class="k-msg k-msg--err" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
    {%- endform -%}
  </div>
</section>
{% schema %}
{"name":"הרשמה לרשימה","tag":"div","settings":[{"type":"text","id":"eyebrow","label":"שורה קטנה","default":"בקרוב"},{"type":"text","id":"title","label":"כותרת","default":"האטלייה של KAV: בגדים שאנחנו מעצבים"},{"type":"textarea","id":"text","label":"טקסט","default":"הקולקציה הראשונה שלנו בדרך. נרשמים לרשימה ושומעים עליה ראשונים."},{"type":"text","id":"button","label":"טקסט כפתור","default":"להצטרף לרשימה"}],"presets":[{"name":"הרשמה לרשימה"}]}
{% endschema %}
