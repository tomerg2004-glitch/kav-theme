<section class="k-section" aria-labelledby="H-{{ section.id }}">
  <div class="k-wrap k-news">
    <div class="k-news__copy">
      <h2 id="H-{{ section.id }}" class="k-display k-h2">{{ section.settings.title }}</h2>
      {%- if section.settings.text != blank -%}<p class="k-lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    {%- form 'customer' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label for="NewsEmail-{{ section.id }}">{{ 'newsletter.email' | t }}</label>
      <div class="k-news__row">
        <input id="NewsEmail-{{ section.id }}" class="k-input" type="email" name="contact[email]" required autocomplete="email" dir="ltr" placeholder="name@example.com" style="text-align:start" aria-describedby="NewsConsent-{{ section.id }}">
        <button class="k-btn k-btn--dark" type="submit">{{ section.settings.button }}</button>
      </div>
      <p class="k-consent" id="NewsConsent-{{ section.id }}">{{ section.settings.consent }}{% if shop.privacy_policy %} <a href="{{ shop.privacy_policy.url }}">{{ 'footer.privacy' | t }}</a>{% endif %}</p>
      {%- if form.posted_successfully? -%}<p class="k-msg" role="status">{{ 'newsletter.success' | t }}</p>{%- endif -%}
      {%- if form.errors -%}<p class="k-msg k-msg--err" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
    {%- endform -%}
  </div>
</section>
{% schema %}
{"name":"הרשמה לעדכונים","tag":"div","settings":[{"type":"text","id":"eyebrow","label":"שורה קטנה","default":"מהדורה 02"},{"type":"text","id":"title","label":"כותרת","default":"המהדורה הבאה כבר בעבודה."},{"type":"textarea","id":"text","label":"טקסט","default":"השאירו מייל, ונודיע לכם כשהיא עולה לאתר."},{"type":"text","id":"button","label":"טקסט כפתור","default":"להירשם"},{"type":"textarea","id":"consent","label":"נוסח ההסכמה","default":"בלחיצה על \"להירשם\" אתם מסכימים לקבל מ-KAV מיילים עם עדכונים ופרסומות. אפשר להסיר את עצמכם בכל רגע דרך הקישור שבתחתית כל מייל."}],"presets":[{"name":"הרשמה לעדכונים"}]}
{% endschema %}
